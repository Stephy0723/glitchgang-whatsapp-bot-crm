WHATSAPP_WEBHOOK_VERIFY_TOKEN=YOUR_PRIVATE_VERIFY_TOKEN

COMMAND_PREFIX=!

CRM_ADMIN_USER=admin
CRM_ADMIN_PASSWORD=change-me-now
CRM_SESSION_SECRET=replace-with-a-long-random-secret
CRM_DATA_FILE=./data/crm.json
