PORT=4100
NODE_ENV=development

# ========================
# Base de datos
# ========================
DATABASE_PATH=./data/glitchgang.db

# API de GlitchGang. Si se deja vacío, el proyecto usa datos demo/locales.
GLITCHGANG_API=
GLITCHGANG_API_TOKEN=

# ========================
# WhatsApp Business Cloud API
# ========================
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# Plantillas de mensajes aprobadas en Meta
WHATSAPP_MESSAGE_TEMPLATE_NAMESPACE=your_namespace
WHATSAPP_OTP_TEMPLATE_NAME=otp_verification
WHATSAPP_NOTIFICATION_TEMPLATE_NAME=notification

# Solo ejecutar el cliente de WhatsApp Web si quieres conectarlo.
ENABLE_WHATSAPP=false

# Limita comandos a grupos concretos. Vacío = cualquier grupo.
ALLOWED_GROUP_IDS=

# Prefijo de comandos
COMMAND_PREFIX=!

# ========================
# CRM
# ========================
CRM_ADMIN_USER=admin
CRM_ADMIN_PASSWORD=change-me-now
CRM_SESSION_SECRET=replace-with-a-long-random-secret
CRM_DATA_FILE=./data/crm.json
